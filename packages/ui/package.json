{
  "name": "@onesaz/ui",
  "version": "0.4.24",
  "description": "Onesaz UI component library - React components with theming and Tailwind CSS",
  "type": "module",
  "license": "MIT",
  "author": "Onesaz <engineering@onesaz.com>",
  "homepage": "https://github.com/onesaz/onesaz-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onesaz/onesaz-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/onesaz/onesaz-ui/issues"
  },
  "keywords": [
    "react",
    "ui-components",
    "design-system",
    "tailwindcss",
    "theming",
    "dark-mode",
    "onesaz"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "node scripts/generate-api-docs.mjs"
  },
  "dependencies": {
    "@onesaz/tokens": "*",
    "@radix-ui/react-accordion": "^1.2.5",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "tsup": "^8.3.5",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
